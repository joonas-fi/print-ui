{
	"for_description_of_this_file_see": "https://github.com/function61/turbobob",
	"version_major": 1,
	"project_name": "print-ui",
	"project_emoji_icon": "",
	"builders": [
		{
			"name": "default",
			"uses": "docker://fn61/buildkit-golang:20260604_1344_ff654e98",
			"commands": {
				"build": ["build-go-project.sh", "--directory=cmd/printers/", "--binary-basename=printers"],
